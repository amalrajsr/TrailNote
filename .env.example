# Turso/libSQL connection. Use file:./data/trailnote.db for local development.
TURSO_DATABASE_URL=
# Required for remote Turso URLs; leave empty for a local file database.
TURSO_AUTH_TOKEN=

# Better Auth server secret and canonical auth URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImageKit server credential and public delivery endpoint.
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Application environment: development, test, preview, or production.
APP_ENV=development
# Secrets used to hash rate-limit keys and authenticate scheduled cleanup.
RATE_LIMIT_SECRET=
CRON_SECRET=

# Public canonical application URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
